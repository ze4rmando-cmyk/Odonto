    <script>
        function openTab(tabName) {
            const contents = document.querySelectorAll('.tab-content');
            const buttons = document.querySelectorAll('.tab-btn');
            
            contents.forEach(content => content.classList.remove('active'));
            buttons.forEach(button => button.classList.remove('active'));
            
            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }

        let correctAnswers = 0;
        let totalQuestions = 10;
        let answeredQuestions = 0;

        function checkAnswer(element) {
            const options = element.parentElement.querySelectorAll('.quiz-option');
            const isCorrect = element.dataset.correct === 'true';
            
            // Evitar responder duas vezes
            if (element.parentElement.dataset.answered) return;
            element.parentElement.dataset.answered = 'true';
            answeredQuestions++;
            
            options.forEach(opt => {
                opt.style.pointerEvents = 'none';
                if (opt.dataset.correct === 'true') {
                    opt.classList.add('correct');
                } else if (opt === element && !isCorrect) {
                    opt.classList.add('incorrect');
                }
            });
            
            if (isCorrect) {
                correctAnswers++;
            }
            
            // Mostrar score quando todas as questões forem respondidas
            if (answeredQuestions === totalQuestions) {
                showScore();
            }
        }

        function showScore() {
            const percentage = (correctAnswers / totalQuestions * 100).toFixed(0);
            const scoreDiv = document.getElementById('quiz-score');
            const resetBtn = document.querySelector('.reset-quiz');
            
            let message = '';
            if (percentage >= 90) {
                message = '🏆 Excelente! Você domina o conteúdo!';
            } else if (percentage >= 70) {
                message = '👏 Muito bom! Continue estudando!';
            } else if (percentage >= 50) {
                message = '📚 Bom esforço! Revise alguns conceitos.';
            } else {
                message = '💪 Continue estudando! Você consegue!';
            }
            
            scoreDiv.innerHTML = `
                <div>${message}</div>
                <div style="font-size: 2rem; margin-top: 0.5rem;">${correctAnswers}/${totalQuestions} (${percentage}%)</div>
            `;
            scoreDiv.style.display = 'block';
            resetBtn.style.display = 'block';
        }

        function resetQuiz() {
            correctAnswers = 0;
            answeredQuestions = 0;
            
            const questions = document.querySelectorAll('.quiz-question');
            questions.forEach(question => {
                const options = question.querySelectorAll('.quiz-option');
                question.querySelector('.quiz-options').removeAttribute('data-answered');
                options.forEach(opt => {
                    opt.classList.remove('correct', 'incorrect');
                    opt.style.pointerEvents = 'auto';
                });
            });
            
            document.getElementById('quiz-score').style.display = 'none';
            document.querySelector('.reset-quiz').style.display = 'none';
            
            // Scroll para o topo do quiz
            document.getElementById('quiz-container').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
